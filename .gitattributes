# Normalize line endings: store LF in the repo, check out as-is.
* text=auto eol=lf

# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# Applied migration checksums are byte-exact; preserve their original line endings.
prisma/migrations/**/migration.sql -text
