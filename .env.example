DATABASE_URL="postgresql://westside:westside@localhost:5432/westside"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Preferred: read-only JSON secret file with unique logins per connection ID.
# Container path is inside the existing read-only deployment mount.
ONEC_SOURCES_FILE=""
# Single-source compatibility: all three values must be explicitly supplied.
# Never infer connection ID from whichever source happens to be active.
ONEC_EXCHANGE_CONNECTION_ID=""
ONEC_EXCHANGE_USER=""
ONEC_EXCHANGE_PASSWORD=""

# Local runtime only. Compose fixes this to the private /app/.media volume.
# Never place invoice PDFs under public/ or .next/.
MEDIA_ROOT=".media"
