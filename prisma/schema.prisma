generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationMode {
  AUTO_APPROVE
  MANUAL_APPROVAL
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

enum BannerPlacement {
  HOME
  CATALOG
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PLACED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum IntegrationProvider {
  ONE_C
  MOYSKLAD
  CUSTOM
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum IntegrationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
}

// Order EXPORT lifecycle — deliberately separate from the business OrderStatus.
// Provider-specific outcomes live here, never inside Order.status.
enum OrderExportStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
}

model Store {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  name         String
  settings     AppSettings?
  users        User[]
  customers    Customer[]
  priceGroups  PriceGroup[]
  priceBooks   PriceBook[]
  categories   Category[]
  brands       Brand[]
  products     Product[]
  locations    InventoryLocation[]
  fulfillmentChannels FulfillmentChannel[]
  banners      SiteBanner[]
  campaigns    Campaign[]
  promotions   Promotion[]
  brandPages   BrandPage[]
  contentBlocks ContentBlock[]
  orders       Order[]
  integrations IntegrationConnection[]
  registrationRequests RegistrationRequest[]
  auditEntries AuditEntry[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model AppSettings {
  id                     String           @id @default(cuid())
  storeId                String           @unique
  store                  Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  registrationMode       RegistrationMode @default(MANUAL_APPROVAL)
  requireAgeConfirmation Boolean          @default(true)
  catalogRequiresAuth    Boolean          @default(true)
  defaultPriceGroupId    String?
  invoicePrefix          String           @default("WS")
  sellerRequisites       Json?
  updatedAt              DateTime         @updatedAt
}

model User {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priceGroupId String?
  priceGroup   PriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  email        String
  passwordHash String
  name         String
  phone        String?
  role         UserRole    @default(BUYER)
  status       UserStatus  @default(ACTIVE)
  moderatedById String?
  moderatedBy   User?       @relation("UserModeration", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedUsers User[]     @relation("UserModeration")
  moderatedAt   DateTime?
  moderationComment String?
  reviewedRegistrations RegistrationRequest[] @relation("RegistrationReviewer")
  registrationRecord    RegistrationRequest?  @relation("RegistrationUser")
  auditEntries          AuditEntry[]          @relation("AuditActor")
  orders       Order[]
  cart         Cart?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storeId, email])
  @@index([storeId, status, createdAt])
  @@index([customerId])
  @@index([priceGroupId])
  @@index([moderatedById])
}

model Customer {
  id          String             @id @default(cuid())
  storeId     String
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  displayName String
  legalName   String
  inn         String
  kpp         String?
  users       User[]
  locations   CustomerLocation[]
  orders      Order[]
  registrationRequests RegistrationRequest[]
  priceAssignment BuyerPriceAssignment?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([storeId, inn])
}

model CustomerLocation {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String
  city       String
  contactName String   @default("")
  contactPhone String  @default("")
  comment     String   @default("")
  isDefault  Boolean  @default(false)
  orders      Order[]  @relation("OrderDeliveryLocation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model PriceGroup {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  code        String
  priority    Int        @default(100)
  priceBookId String?
  priceBook   PriceBook? @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  users       User[]
  fulfillmentChannels FulfillmentChannel[]
  registrationRequests RegistrationRequest[]
  assignments BuyerPriceAssignment[]

  @@unique([storeId, code])
  @@index([priceBookId])
}

model Category {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  name      String
  slug      String
  sortOrder Int        @default(0)
  products  Product[]

  @@unique([storeId, slug])
}

model Brand {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  logoUrl  String?
  products Product[]
  banners  SiteBanner[]
  page     BrandPage?

  @@unique([storeId, slug])
}

// Canonical product identity. Holds NO storefront content — display name,
// descriptions, images, SEO and merchandising live in CommerceProductContent
// (the commerce-owned overlay) and are never overwritten by provider sync.
// The `id` is stable and is the canonical key mapped to a provider via
// ExternalReference, so swapping the operational provider never migrates IDs.
model Product {
  id            String                  @id @default(cuid())
  storeId       String
  store         Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  canonicalName String
  status        ProductStatus           @default(DRAFT)
  variants      ProductVariant[]
  content       CommerceProductContent?
  orderItems    OrderItem[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([storeId, status])
  @@index([categoryId])
  @@index([brandId])
}

// Sellable unit (SKU). Canonical/operational attributes only.
model ProductVariant {
  id           String              @id @default(cuid())
  storeId      String
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String
  packaging    String              @default("")
  unitsPerPack Int                 @default(1)
  isDefault    Boolean             @default(true)
  status       ProductStatus       @default(ACTIVE)
  sortOrder    Int                 @default(0)
  identifiers  ProductIdentifier[]
  prices       PriceEntry[]
  stocks       Stock[]
  availability AvailabilityProjection[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([storeId, sku])
  @@index([productId])
}

// Barcodes / articles that identify a SKU across systems.
model ProductIdentifier {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      String
  value     String
  createdAt DateTime       @default(now())

  @@unique([variantId, type, value])
  @@index([type, value])
}

// Commerce-owned storefront overlay (1:1 with a canonical product). Edits by
// staff survive provider normalization — sync updates canonical identity, never
// these fields ("overlay wins").
model CommerceProductContent {
  id             String   @id @default(cuid())
  storeId        String
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayName    String
  slug           String
  description    String   @default("")
  imageUrls      String[]
  seoTitle       String?
  seoDescription String?
  attributes     Json?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

// Raw, normalizable provider snapshot kept separate from canonical data so we
// can always prove what the provider sent and which normalizer processed it.
model ProviderSnapshot {
  id                   String    @id @default(cuid())
  storeId              String
  connectionId         String?
  entityType           String
  externalId           String
  sourceFingerprint    String
  providerVersion      String?
  sourceUpdatedAt      DateTime?
  receivedAt           DateTime  @default(now())
  normalizationVersion String
  payload              Json
  createdAt            DateTime  @default(now())

  @@index([storeId, entityType, externalId])
  @@index([entityType, externalId, sourceFingerprint])
}

// A named price list. The applicable book for a context is resolved as
// channel.priceBook -> group.priceBook -> store default, then a PriceEntry for
// the variant gives the amount. Price is thus a function of context, never a
// single Product.price.
model PriceBook {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code      String
  name      String
  currency  String       @default("RUB")
  isDefault Boolean      @default(false)
  entries   PriceEntry[]
  groups    PriceGroup[]
  channels  FulfillmentChannel[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([storeId, code])
}

model PriceEntry {
  id            String         @id @default(cuid())
  priceBookId   String
  priceBook     PriceBook      @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(18, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  updatedAt     DateTime       @updatedAt

  @@unique([priceBookId, variantId])
  @@index([variantId])
}

// Authoritative buyer -> price group assignment (one active group per customer),
// replacing the ad-hoc User.priceGroupId. Resolution prefers this; User.priceGroupId
// remains a compatibility fallback.
model BuyerPriceAssignment {
  id           String     @id @default(cuid())
  storeId      String
  customerId   String     @unique
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceGroupId String
  priceGroup   PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Restrict)
  assignedById String?
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  @@index([storeId])
  @@index([priceGroupId])
}

model InventoryLocation {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code    String
  name    String
  stocks  Stock[]
  fulfillmentChannels FulfillmentChannel[]
  orders  Order[] @relation("OrderInventoryLocation")

  @@unique([storeId, code])
}

model FulfillmentChannel {
  id                  String            @id @default(cuid())
  storeId             String
  store               Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryLocationId String
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  priceGroupId        String?
  priceGroup          PriceGroup?       @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  priceBookId         String?
  priceBook           PriceBook?        @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  code                String
  name                String
  paymentMethod       PaymentMethod
  sellerLegalEntity   Json?
  invoiceProfile      Json?
  isActive            Boolean           @default(true)
  sortOrder           Int               @default(0)
  orders              Order[]
  availability        AvailabilityProjection[]
  carts               Cart[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([storeId, code])
  @@index([storeId, paymentMethod, isActive])
  @@index([inventoryLocationId])
  @@index([priceGroupId])
  @@index([priceBookId])
}

// Raw per-location quantity imported from the provider. This is the SOURCE for
// AvailabilityProjection — the storefront reads the projection, not this.
model Stock {
  id              String            @id @default(cuid())
  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId      String
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  available       Decimal           @db.Decimal(18, 3)
  reserved        Decimal           @default(0) @db.Decimal(18, 3)
  sourceUpdatedAt DateTime?
  updatedAt       DateTime          @updatedAt

  @@unique([variantId, locationId])
}

// Storefront-facing availability per (variant, channel), decoupled from live
// provider calls. `sourceUpdatedAt` lets the UI flag staleness; a provider
// outage never blocks the storefront — the last projection is served.
model AvailabilityProjection {
  id                   String             @id @default(cuid())
  variantId            String
  variant              ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fulfillmentChannelId String
  fulfillmentChannel   FulfillmentChannel @relation(fields: [fulfillmentChannelId], references: [id], onDelete: Cascade)
  availableQuantity    Decimal            @db.Decimal(18, 3)
  sourceUpdatedAt      DateTime?
  updatedAt            DateTime           @updatedAt

  @@unique([variantId, fulfillmentChannelId])
  @@index([fulfillmentChannelId])
}

model Order {
  id         String             @id @default(cuid())
  storeId    String
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryLocationId String
  deliveryLocation   CustomerLocation @relation("OrderDeliveryLocation", fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  inventoryLocationId String
  inventoryLocation InventoryLocation @relation("OrderInventoryLocation", fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  fulfillmentChannelId String
  fulfillmentChannel FulfillmentChannel @relation(fields: [fulfillmentChannelId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod
  number     String
  status     OrderStatus        @default(DRAFT)
  idempotencyKey String?        @unique
  total      Decimal            @db.Decimal(18, 2)
  currency   String             @default("RUB")
  comment    String             @default("")
  items      OrderItem[]
  invoices   Invoice[]
  export     OrderExport?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([storeId, number])
  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([deliveryLocationId])
  @@index([inventoryLocationId, createdAt])
  @@index([fulfillmentChannelId, createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku         String
  productName String
  packaging   String
  quantity    Decimal         @db.Decimal(18, 3)
  unitPrice   Decimal         @db.Decimal(18, 2)
  lineTotal   Decimal         @db.Decimal(18, 2)
}

// Server-side cart: authoritative quantities, bound to a buyer and a chosen
// fulfillment channel. Prices/availability are resolved live for display and
// re-validated + snapshotted at checkout (client can never dictate price).
model Cart {
  id                   String              @id @default(cuid())
  storeId              String
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfillmentChannelId String?
  fulfillmentChannel   FulfillmentChannel? @relation(fields: [fulfillmentChannelId], references: [id], onDelete: SetNull)
  items                CartItem[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([fulfillmentChannelId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Decimal        @db.Decimal(18, 3)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

// Durable per-order export state (integration lifecycle). The Commerce Order ID
// is the idempotency key at the provider, so re-submitting one order never
// creates a duplicate. Retries are bounded; errors persist in IntegrationError.
model OrderExport {
  id           String            @id @default(cuid())
  storeId      String
  orderId      String            @unique
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  connectionId String?
  status       OrderExportStatus @default(PENDING)
  attempts     Int               @default(0)
  maxAttempts  Int               @default(5)
  availableAt  DateTime          @default(now())
  externalId   String?
  lastError    String?
  submittedAt  DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([storeId, status])
}

// An issued invoice is an immutable financial document. The seller/buyer
// requisites, VAT and line amounts are SNAPSHOTTED at issue time — later
// changes to the store's seller requisites or the order never alter an invoice
// already issued. A reissue creates a NEW row (version + 1) and VOIDs the
// previous one; old rows/lines are never mutated. `sellerSnapshot`/
// `buyerSnapshot` are nullable only to keep the migration additive — issued
// invoices always carry them; a null snapshot marks a legacy row.
model Invoice {
  id             String        @id @default(cuid())
  storeId        String
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number         String        @unique
  version        Int           @default(1)
  status         InvoiceStatus @default(ISSUED)
  sellerSnapshot Json?
  buyerSnapshot  Json?
  subtotal       Decimal       @default(0) @db.Decimal(18, 2)
  vatRate        Decimal?      @db.Decimal(6, 3)
  vatAmount      Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @default(0) @db.Decimal(18, 2)
  currency       String        @default("RUB")
  lines          InvoiceLine[]
  issuedAt       DateTime      @default(now())
  pdfPath        String?

  @@unique([orderId, version])
  @@index([storeId, status])
}

// Immutable per-line snapshot of the order at the moment the invoice was issued.
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int
  sku       String
  name      String
  packaging String  @default("")
  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 2)
  lineTotal Decimal @db.Decimal(18, 2)

  @@unique([invoiceId, position])
}

model SiteBanner {
  id              String          @id @default(cuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brandId         String?
  brand           Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  placement       BannerPlacement @default(CATALOG)
  name            String
  desktopImageUrl String?
  mobileImageUrl  String?
  linkUrl         String?
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([storeId, placement, isActive, sortOrder])
  @@index([brandId])
  @@index([campaignId])
}

// A named merchandising campaign grouping banners and price promotions under a
// shared active window. Content (banners/pages) and pricing (promotions) both
// reference it, but neither depends on the other.
model Campaign {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  priority    Int          @default(100)
  isActive    Boolean      @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  banners     SiteBanner[]
  promotions  Promotion[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, isActive])
}

// A price rule applied in the pricing function (the M5 extension point). It
// never mutates a PriceEntry — it discounts the resolved contextual price at
// read time, so a released invoice (a snapshot) is never retroactively changed.
// `scope` targets brand/category/variant ids; an empty/absent scope = all.
// Overlaps resolve by `priority` (higher wins); `stackable` rules compose.
model Promotion {
  id         String        @id @default(cuid())
  storeId    String
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name       String
  type       PromotionType @default(PERCENTAGE)
  value      Decimal       @db.Decimal(18, 2)
  priority   Int           @default(100)
  stackable  Boolean       @default(false)
  isActive   Boolean       @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  scope      Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([storeId, isActive, priority])
  @@index([campaignId])
}

// Merchandising overlay for a brand's storefront page (hero + rich body). One
// per brand. Provider sync never touches it (commerce-owned, "overlay wins").
model BrandPage {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brandId      String   @unique
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title        String
  heroImageUrl String?
  body         Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId, isActive])
}

// A keyed, placement-scoped block of managed storefront content (not a full
// CMS — see plan §4 non-goals). Read-model resolves active blocks by placement.
model ContentBlock {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key       String
  placement String   @default("HOME")
  title     String?
  body      Json?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([storeId, placement, isActive, sortOrder])
}

model IntegrationConnection {
  id         String              @id @default(cuid())
  storeId    String
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider   IntegrationProvider
  name       String
  enabled    Boolean             @default(false)
  config     Json?
  references  ExternalReference[]
  cursors     SyncCursor[]
  runs        SyncRun[]
  jobs        IntegrationJob[]
  checkpoints SyncCheckpoint[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([storeId, provider, name])
}

model ExternalReference {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  externalId   String
  externalCode String?
  sourceData   Json?
  updatedAt    DateTime              @updatedAt

  @@unique([connectionId, entityType, externalId])
  @@unique([connectionId, entityType, entityId])
}

model SyncCursor {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType   String
  cursor       String?
  lastSyncAt   DateTime?
  lastError    String?

  @@unique([connectionId, entityType])
}

model SyncRun {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType   String
  status       SyncStatus            @default(PENDING)
  stats        Json?
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime              @default(now())
}

model OutboxEvent {
  id          String       @id @default(cuid())
  storeId     String
  eventType   String
  aggregateId String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

// Durable unit of integration work. Authoritative state lives in PostgreSQL
// (no broker). Jobs are idempotent (unique idempotencyKey), retried up to
// maxAttempts, and resumable after restart via SyncCheckpoint.
model IntegrationJob {
  id             String               @id @default(cuid())
  storeId        String
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type           String
  idempotencyKey String               @unique
  status         IntegrationJobStatus @default(PENDING)
  payload        Json?
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(5)
  availableAt    DateTime             @default(now())
  lastError      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  attemptsLog    IntegrationAttempt[]
  errors         IntegrationError[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, availableAt])
  @@index([connectionId, type])
}

model IntegrationAttempt {
  id         String               @id @default(cuid())
  jobId      String
  job        IntegrationJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt    Int
  status     IntegrationJobStatus
  stats      Json?
  error      String?
  startedAt  DateTime             @default(now())
  finishedAt DateTime?

  @@index([jobId])
}

// Persisted integration errors for observability / DLQ inspection and retry.
model IntegrationError {
  id           String          @id @default(cuid())
  storeId      String
  connectionId String?
  jobId        String?
  job          IntegrationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  code         String
  message      String
  context      Json?
  createdAt    DateTime        @default(now())

  @@index([storeId, createdAt])
  @@index([connectionId, createdAt])
}

// Cross-job resume marker for page-based import. Survives restarts so a new run
// continues where the previous left off.
model SyncCheckpoint {
  id             String                @id @default(cuid())
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType     String
  cursor         String?
  page           Int                   @default(0)
  processed      Int                   @default(0)
  completed      Boolean               @default(false)
  lastExternalId String?
  updatedAt      DateTime              @updatedAt

  @@unique([connectionId, entityType])
}

// Inbound idempotency ledger: an external item already processed with the same
// fingerprint is skipped on re-import.
model Inbox {
  id           String   @id @default(cuid())
  storeId      String
  connectionId String
  entityType   String
  externalId   String
  fingerprint  String
  status       String   @default("PROCESSED")
  receivedAt   DateTime @default(now())

  @@unique([connectionId, entityType, externalId])
  @@index([storeId, entityType])
}

// A B2B access application, kept separate from the activated User so the
// request (and its moderation outcome) survives as a record. On approval a
// Customer + User are created inside one transaction; on rejection the request
// is retained with a reason. See docs/AXIMA_COMMERCE_IMPLEMENTATION_PLAN.md M2.
model RegistrationRequest {
  id                   String             @id @default(cuid())
  storeId              String
  store                Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email                String
  passwordHash         String
  contactName          String
  phone                String?
  legalName            String
  inn                  String
  kpp                  String?
  status               RegistrationStatus @default(PENDING)
  reviewedById         String?
  reviewedBy           User?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  comment              String?
  assignedPriceGroupId String?
  assignedPriceGroup   PriceGroup?        @relation(fields: [assignedPriceGroupId], references: [id], onDelete: SetNull)
  createdUserId        String?            @unique
  createdUser          User?              @relation("RegistrationUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  createdCustomerId    String?
  createdCustomer      Customer?          @relation(fields: [createdCustomerId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([storeId, status, createdAt])
  @@index([storeId, email])
  @@index([reviewedById])
  @@index([assignedPriceGroupId])
  @@index([createdCustomerId])
}

// Append-only record of critical staff/admin actions (who changed what, by
// hand). NOT analytics domain events. Introduced in M2 and reused by later
// milestones (PriceGroupChanged, OrderStatusChanged, InvoiceReissued, ...).
model AuditEntry {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  targetType String
  targetId   String
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}
