{
  "name": "westside-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/commerce-boundaries.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:int:setup": "node scripts/test-db-setup.mjs",
    "install:server": "node scripts/deploy.mjs install",
    "update:server": "sh ./update.sh",
    "license:keygen": "node services/license-server/keygen.mjs",
    "license:issue": "node services/license-server/issue.mjs",
    "license:server": "node services/license-server/server.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "node dist/integration-worker.cjs",
    "ed:build": "node scripts/build-enterprisedata-pilot.mjs",
    "ed:pilot": "node dist/enterprisedata-pilot.cjs",
    "test:release-checks": "node --test scripts/commerce-boundaries.test.mjs scripts/release-checks.test.mjs",
    "check:release": "node scripts/release-checks.mjs",
    "acceptance": "node scripts/release-checks.mjs --acceptance",
    "test:license-smoke": "node scripts/license-smoke.mjs",
    "test:deployment": "node --test tests/deployment/deploy.test.mjs tests/deployment/archive-guard.test.mjs tests/deployment/test-db-guard.test.mjs",
    "check:deployment": "node scripts/deployment-drill.mjs",
    "install:config": "node scripts/install.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^3.4.5",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
