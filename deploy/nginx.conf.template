# AXIMA Commerce reverse proxy template. `__DOMAIN__` is substituted by install.sh.
# TLS directives are added by certbot (--nginx). This provides the HTTP vhost and
# security headers; HTTPS redirect is installed by certbot on success.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Security headers at the edge (mirrors app-level next.config.mjs).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Single trusted ingress: discard client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long enough for a full 1C catalog import triggered from the backoffice.
        proxy_read_timeout 900s;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:3000/api/health;
        access_log off;
    }
}
